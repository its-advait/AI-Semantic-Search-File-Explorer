{
  "name": "bench-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "npm-run-all -p dev start:main",
    "start:main": "wait-on http://localhost:3000 && npm run dev -w @bench/main",
    "dev": "npm run dev -w @bench/renderer",
    "build": "npm run build -w @bench/renderer",
    "postinstall": "npm run build"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^37.2.3",
    "npm-run-all": "^4.1.5",
    "supabase": "^2.31.4",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "next": "^15.4.2"
  }
}
